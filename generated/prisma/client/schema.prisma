generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma/client"
}

datasource db {
  provider = "postgresql"
}

enum VendorStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED
}

enum RiderStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PREPARING
  READY_FOR_PICKUP
  PICKED_UP
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum VehicleType {
  BICYCLE
  MOTORCYCLE
  CAR
}

model User {
  id                  String   @id @default(cuid())
  clerkUserId         String   @unique
  firstName           String
  lastName            String
  username            String   @unique
  email               String   @unique
  phoneNumber         String?
  address             String?
  state               String?
  localGovernmentArea String?
  avatar              String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  orders              Order[]
}

model Vendor {
  id                  String          @id @default(cuid())
  clerkUserId         String          @unique
  name                String
  slug                String          @unique
  description         String
  logo                String
  address             String
  landmark            String?
  latitude            Float?
  longitude           Float?
  state               String
  localGovernmentArea String
  phoneNumber         String
  cuisineType         String[]
  status              VendorStatus    @default(PENDING)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  images              String[]
  backUpPhoneNumber   String?
  menuItems           MenuItem[]
  categories          Category[]
  orders              Order[]
  email               String
  adminNote           String?
  closeOpenStatus     Boolean         @default(false)
  packTypes           PackType[]
  proteinOptions      ProteinOption[]
  sideOptions         SideOption[]
  carbOptions         CarbOption[]
  minimumPrice        Decimal?
}

model Category {
  id        String     @id @default(cuid())
  name      String
  slug      String
  vendorId  String
  vendor    Vendor     @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  menuItems MenuItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([vendorId, name])
}

model MenuItem {
  id                     String      @id @default(cuid())
  vendorId               String
  categoryId             String
  category               Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name                   String
  slug                   String
  description            String
  price                  Decimal
  image                  String
  isAvailable            Boolean     @default(false)
  discount               Float?
  addProteinOptions      Boolean     @default(false)
  addCarbohydrateOptions Boolean     @default(false)
  addSides               Boolean     @default(false)
  vendor                 Vendor      @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  orderItems             OrderItem[]
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt

  @@unique([vendorId, slug])
}

model CarbOption {
  id             String          @id @default(cuid())
  name           String
  slug           String
  image          String
  extraPrice     Decimal         @default(0)
  isAvailable    Boolean         @default(true)
  vendorId       String
  createdAt      DateTime        @default(now())
  vendor         Vendor          @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  orderItemCarbs OrderItemCarb[]

  @@unique([vendorId, slug])
}

model PackType {
  id          String  @id @default(cuid())
  name        String
  slug        String
  extraPrice  Decimal @default(0)
  isAvailable Boolean @default(true)
  vendorId    String
  vendor      Vendor  @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  orders      Order[]
}

model OrderItemCarb {
  id           String     @id @default(cuid())
  orderItem    OrderItem  @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  orderItemId  String
  carbOption   CarbOption @relation(fields: [carbOptionId], references: [id])
  carbOptionId String
  createdAt    DateTime   @default(now())
  unitPrice    Decimal
  quantity     Int        @default(1)

  @@unique([orderItemId, carbOptionId])
}

model SideOption {
  id             String          @id @default(cuid())
  name           String
  slug           String
  extraPrice     Decimal         @default(0)
  isAvailable    Boolean         @default(true)
  vendorId       String
  image          String
  createdAt      DateTime        @default(now())
  vendor         Vendor          @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  orderItemSides OrderItemSide[]

  @@unique([vendorId, slug])
}

model OrderItemSide {
  id           String     @id @default(cuid())
  orderItem    OrderItem  @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  orderItemId  String
  sideOption   SideOption @relation(fields: [sideOptionId], references: [id])
  sideOptionId String
  unitPrice    Decimal
  quantity     Int        @default(1)
  createdAt    DateTime   @default(now())

  @@unique([orderItemId, sideOptionId])
}

model ProteinOption {
  id                String             @id @default(cuid())
  name              String
  slug              String
  extraPrice        Decimal            @default(0)
  isAvailable       Boolean            @default(true)
  vendorId          String
  image             String
  createdAt         DateTime           @default(now())
  vendor            Vendor             @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  orderItemProteins OrderItemProtein[]

  @@unique([vendorId, slug])
}

model OrderItemProtein {
  id              String        @id @default(cuid())
  orderItem       OrderItem     @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  orderItemId     String
  proteinOption   ProteinOption @relation(fields: [proteinOptionId], references: [id])
  proteinOptionId String
  unitPrice       Decimal
  quantity        Int           @default(1)
  createdAt       DateTime      @default(now())

  @@unique([orderItemId, proteinOptionId])
}

model Rider {
  id          String      @id @default(cuid())
  name        String
  clerkUserId String      @unique
  phone       String
  vehicleType VehicleType
  isAvailable Boolean     @default(false)
  status      RiderStatus @default(PENDING)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  orders      Order[]
}

model Order {
  id              String      @id @default(cuid())
  userId          String
  user            User        @relation(fields: [userId], references: [id])
  vendorId        String
  vendor          Vendor      @relation(fields: [vendorId], references: [id])
  riderId         String?
  rider           Rider?      @relation(fields: [riderId], references: [id])
  status          OrderStatus @default(PENDING_PAYMENT)
  totalAmount     Decimal
  deliveryAddress String
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  packTypeId      String?
  packType        PackType?   @relation(fields: [packTypeId], references: [id])
  orderItems      OrderItem[]
}

model OrderItem {
  id                String             @id @default(cuid())
  orderId           String
  order             Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId        String
  menuItem          MenuItem           @relation(fields: [menuItemId], references: [id])
  quantity          Int
  unitPrice         Decimal
  createdAt         DateTime           @default(now())
  orderItemSides    OrderItemSide[]
  orderItemCarbs    OrderItemCarb[]
  orderItemProteins OrderItemProtein[]
}
